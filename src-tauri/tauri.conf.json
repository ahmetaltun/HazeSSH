{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haze SSH",
  "version": "0.4.0",
  "identifier": "com.hazessh.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Haze SSH",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "visible": false,
        "backgroundColor": "#282a36"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQkY5MzU4QkMyRTk1RkEKUldUNmxTNjhXSk8vVVVydnYwRmM3RW9PdFd2ZXgxaTZmYzdmS29PMFkzdktaM0xKbTk5MDhwNW0K",
      "endpoints": [
        "https://github.com/ahmetaltun/HazeSSH/releases/latest/download/latest.json"
      ]
    }
  }
}
